{
  id = "runtime-host-wasm-product-path",
  display_name = "Runtime host WASM product-path E2E",
  description = "Runs a declared WASM unit through Aspen job-manager and worker-pool orchestration, retrieves the unit from blob storage, executes its exported entrypoint, and checks product-visible receipt markers.",
  layer = "rust-integration",
  owner = "runtime-host",
  runtime_class = "real-network",
  prerequisites = [],
  tags = [
    "runtime-host",
    "wasm",
    "jobs",
    "product-path",
    "e2e",
  ],
  capabilities = [
    "blob-backed-wasm-unit",
    "job-manager-submit",
    "worker-pool-orchestration",
    "product-visible-receipt",
  ],
  isolation_assumptions = [
    "The fixture uses the committed aspen:runtime-host/wasm-v1 ABI with an execute() -> i32 export.",
    "Runtime-core-only admission tests and plugin install/reload commands are guardrails only and do not satisfy this row.",
  ],
  runtime_host = {
    kind = "wasm",
    proof_level = "aspen-spawned-execution",
    support_status = "e2e-registered",
  },
  timeout_class = "quick",
  expected_artifacts = [],
  convergence_assertions = [
    "ASPEN_WASM_RUNTIME_HOST_EXECUTED appears in the job result receipt",
    "ASPEN_WASM_RUNTIME_HOST_PRODUCT_PATH_GUARD distinguishes negative guardrails from execution evidence",
    "Submitted jobs record at least one worker-pool execution attempt before reaching a terminal state",
  ],
  target = {
    kind = "cargo-nextest",
    package = "aspen-jobs",
    test = "wasm_product_path_test",
    features = ["plugins-wasm"],
    run_ignored = "default",
  },
}
