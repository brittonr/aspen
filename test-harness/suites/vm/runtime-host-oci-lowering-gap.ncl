{
  id = "runtime-host-oci-lowering-product-path",
  display_name = "Runtime host OCI lowering product-path E2E",
  description = "Validates immutable OCI source identity, deterministic lowering into an isolated WASM target artifact, Aspen job-manager and worker-pool execution of that derived artifact, and a product-visible receipt linking source OCI digest to target host execution.",
  layer = "rust-integration",
  owner = "runtime-host",
  runtime_class = "real-network",
  prerequisites = [],
  tags = [
    "runtime-host",
    "oci-lowering",
    "wasm",
    "jobs",
    "product-path",
    "e2e",
  ],
  capabilities = [
    "immutable-oci-source-identity",
    "derived-isolated-target-artifact",
    "blob-backed-wasm-unit",
    "job-manager-submit",
    "worker-pool-orchestration",
    "product-visible-receipt",
  ],
  isolation_assumptions = [
    "The row proves OCI lowering into a supported isolated WASM host; it does not declare raw container execution as runtime-host evidence.",
    "The fixture uses an immutable sha256: OCI source identity and a declared aspen:runtime-host/wasm-v1 derived artifact.",
    "Admission, model, build, or metadata-only checks are guardrails only and do not satisfy this row without the product-path job receipt.",
  ],
  runtime_host = {
    kind = "oci-lowering",
    proof_level = "aspen-spawned-execution",
    support_status = "e2e-registered",
  },
  timeout_class = "quick",
  expected_artifacts = [],
  convergence_assertions = [
    "ASPEN_OCI_LOWERING_RUNTIME_HOST_EXECUTED appears in the product receipt",
    "ASPEN_OCI_LOWERING_RUNTIME_HOST_PRODUCT_PATH_GUARD distinguishes negative guardrails from execution evidence",
    "The receipt links an immutable sha256: OCI source identity to a declared derived isolated target artifact",
    "Submitted jobs record at least one worker-pool execution attempt before reaching a terminal state",
  ],
  target = {
    kind = "cargo-nextest",
    package = "aspen-jobs",
    test = "oci_lowering_product_path_test",
    features = ["plugins-wasm"],
    run_ignored = "default",
  },
}
