{
  id = "runtime-host-hyperlight-product-path",
  display_name = "Runtime host Hyperlight product-path E2E",
  description = "Runs a declared Hyperlight guest through Aspen job-manager and worker-pool orchestration, retrieves the guest ELF from blob storage, executes its declared entrypoint, and checks product-visible receipt markers.",
  layer = "rust-integration",
  owner = "runtime-host",
  runtime_class = "real-network",
  prerequisites = ["nested-kvm"],
  tags = [
    "runtime-host",
    "hyperlight",
    "jobs",
    "product-path",
    "e2e",
    "gated",
  ],
  capabilities = [
    "blob-backed-hyperlight-guest",
    "job-manager-submit",
    "worker-pool-orchestration",
    "product-visible-receipt",
  ],
  isolation_assumptions = [
    "The fixture uses the committed aspen:runtime-host/hyperlight-v1 ABI with an execute(VecBytes) -> VecBytes entrypoint.",
    "The positive proof is ignored by default and must be run deliberately on a Hyperlight/KVM-capable host.",
    "Worker construction, payload serialization, package builds, ignored/manual examples, and direct worker-only calls are guardrails only and do not satisfy this row.",
  ],
  runtime_host = {
    kind = "hyperlight",
    proof_level = "aspen-spawned-execution",
    support_status = "e2e-registered",
  },
  timeout_class = "extended",
  expected_artifacts = [],
  convergence_assertions = [
    "ASPEN_HYPERLIGHT_RUNTIME_HOST_EXECUTED appears in the job result receipt",
    "ASPEN_HYPERLIGHT_RUNTIME_HOST_PRODUCT_PATH_GUARD distinguishes negative guardrails from execution evidence",
    "Submitted jobs record at least one worker-pool execution attempt before reaching a terminal state",
  ],
  target = {
    kind = "cargo-nextest",
    package = "aspen-jobs",
    test = "hyperlight_product_path_test",
    features = ["plugins-vm"],
    run_ignored = "ignored-only",
  },
}
