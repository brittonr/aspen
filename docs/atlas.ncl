{
  schema = "molten-system-atlas.v1",
  title = "Aspen system atlas",
  summary = "A bounded map of the current Aspen runtime, storage, and networking boundaries. It is explanatory and does not replace the governing documents or lifecycle evidence.",
  chapters = [
    {
      id = "turn-runtime",
      title = "Turn and dataspace runtime",
      summary = "Canonical envelopes, pure transitions, effect plans, and replay-visible observations.",
      components = [ "runtime", "dataspaces", "effects" ],
      questions = [ "q-replay", "q-effect-uncertainty" ],
    },
    {
      id = "storage",
      title = "Storage and world state",
      summary = "Prolly maps, Redb durability, content identity, and world commit or restore boundaries.",
      components = [ "prolly", "redb", "content-store", "world", "node-state" ],
      questions = [ "q-prolly-work", "q-restore" ],
    },
    {
      id = "networking",
      title = "Networking and admission",
      summary = "Iroh session admission and bounded loopback or explicit direct-LAN adapters; actual cross-host qualification remains separate.",
      components = [ "transport", "admission" ],
      questions = [ "q-rate-limit", "q-cross-host" ],
    },
    {
      id = "evidence",
      title = "Evidence and qualification",
      summary = "Implementation coverage, exact execution artifacts and diagnostic reports remain distinct from authority or release admission.",
      components = [ "qualification" ],
      questions = [ "q-qualification" ],
    },
  ],
  components = [
    {
      id = "runtime",
      label = "Runtime kernel",
      summary = "Pure transitions and typed effect plans with explicit replay state.",
      source = "src/runtime/",
      chapter = "turn-runtime",
    },
    {
      id = "dataspaces",
      label = "Dataspaces",
      summary = "Assertions, retractions, observe patterns, and service dependency facts.",
      source = "src/runtime/dataspace/",
      chapter = "turn-runtime",
    },
    {
      id = "effects",
      label = "Effect boundary",
      summary = "Capability-rooted adapters perform effects; authority and uncertainty stay explicit.",
      source = "src/effects/",
      chapter = "turn-runtime",
    },
    {
      id = "prolly",
      label = "Prolly map",
      summary = "History-independent ordered state with a bounded incremental edit path and rebuild fallback.",
      source = "crates/molten-core/src/prolly_map/",
      chapter = "storage",
    },
    {
      id = "redb",
      label = "Redb stores",
      summary = "Capability-rooted durable logs, snapshots, indexes, and partial-state records.",
      source = "src/chunk/store.rs",
      chapter = "storage",
    },
    {
      id = "content-store",
      label = "Content store adapters",
      summary = "Canonical manifests and verified chunks across local, Redb, Iroh, optional object-storage and simulation profiles.",
      source = "src/content_store_adapter/",
      chapter = "storage",
    },
    {
      id = "world",
      label = "World lifecycle",
      summary = "Commit, branch heads, diff/merge, promotion, and logical restore boundaries.",
      source = "src/worldcommit/",
      chapter = "storage",
    },
    {
      id = "node-state",
      label = "Node state storage",
      summary = "Capability-rooted node namespaces and typed store roots; world commits persist through its storage namespace.",
      source = "src/node_state/",
      chapter = "storage",
    },
    {
      id = "transport",
      label = "Fabric transport",
      summary = "Bounded Iroh sessions, registered protocols, peer evidence, and cleanup.",
      source = "src/fabric_transport/",
      chapter = "networking",
    },
    {
      id = "admission",
      label = "Admission",
      summary = "Peer, membership, principal, trust, capability, resource, and policy observations.",
      source = "crates/molten-core/src/fabric_transport/",
      chapter = "networking",
    },
    {
      id = "qualification",
      label = "Capability qualification",
      summary = "Read-only, exact-build artifact validation; incomplete or simulation evidence cannot qualify live durability or cross-host behavior.",
      source = "tools/capability-report.rs",
      chapter = "evidence",
    },
  ],
  edges = [
    {
      from = "runtime",
      to = "effects",
      message = "typed effect request and terminal observation",
      payload = {
        type = "EffectRequest / EffectResponse",
        fields = [ "request_ref", "effect_id", "operation", "handler_profile", "capability_refs", "decision", "output_ref" ],
        source = "src/effects/parts/mod/p000/body.rs",
      },
      chapter = "turn-runtime",
    },
    {
      from = "dataspaces",
      to = "runtime",
      message = "assertion or retraction turn plan",
      payload = {
        type = "PendingTurn",
        fields = [ "actions", "events", "actor", "cause" ],
        source = "src/runtime/turn/mod.rs",
      },
      chapter = "turn-runtime",
    },
    {
      from = "runtime",
      to = "content-store",
      message = "content operation and canonical manifest ref",
      payload = {
        type = "ContentCommand",
        fields = [ "operation_ref", "adapter_ref", "operation", "manifest_ref", "range", "deadline_tick" ],
        source = "crates/molten-core/src/content_store_adapter/model.rs",
      },
      chapter = "storage",
    },
    {
      from = "prolly",
      to = "redb",
      message = "immutable block publication and generation check",
      payload = {
        type = "ProllyPublicationReceipt",
        fields = [ "map_id", "prior_root_ref", "next_root_ref", "generation", "staged_block_refs", "status" ],
        source = "src/prolly_map/records.rs",
      },
      chapter = "storage",
    },
    {
      from = "world",
      to = "node-state",
      message = "content-addressed root objects, canonical commit, and capture receipt",
      payload = {
        type = "CaptureReceipt",
        fields = [ "decision", "commit_ref", "persisted_roots", "revision_fences", "publication" ],
        source = "src/worldcommit/wire.rs",
      },
      chapter = "storage",
    },
    {
      from = "transport",
      to = "admission",
      message = "authenticated session and bounded frame observation",
      payload = {
        type = "ReceiveObservation",
        fields = [ "peer_identity", "peer_context_ref", "service_id", "alpn", "generation", "role" ],
        source = "crates/molten-core/src/fabric_transport/receive.rs",
      },
      chapter = "networking",
    },
    {
      from = "admission",
      to = "effects",
      message = "admitted operation scope, never ambient authority",
      payload = {
        type = "AdmittedOperation",
        fields = [ "request", "peer", "authority_ref" ],
        source = "src/fabric_transport/cross_process/iroh/direct.rs",
      },
      chapter = "networking",
    },
    {
      from = "runtime",
      to = "qualification",
      message = "canonical profile-scoped execution observations, never ambient authority",
      payload = {
        type = "ObservedReadback",
        fields = [ "subjects", "binding_ref", "validation_ref", "receipt_refs" ],
        source = "src/capability_qualification/model.rs",
      },
      chapter = "evidence",
    },
  ],
  questions = [
    {
      id = "q-replay",
      text = "Which runtime transitions are replay-visible for the selected profile?",
      status = "open",
      link = "world-replay-capsules.md",
    },
    {
      id = "q-effect-uncertainty",
      text = "How does the selected adapter classify an effect that may have happened?",
      status = "open",
      link = "fabric-port-ownership.md",
    },
    {
      id = "q-prolly-work",
      text = "What work does an incremental Prolly edit bound actually avoid?",
      status = "open",
      link = "prolly-semantic-state-map.md",
    },
    {
      id = "q-restore",
      text = "Which logical restore profile has exact current-admission and restart qualification?",
      status = "blocked",
      link = "world-execution-snapshots.md",
    },
    {
      id = "q-rate-limit",
      text = "Is a per-source rate limit applied before inbound admission?",
      status = "answered",
      link = "inbound-admission-rate-limit-review.md",
      tracking = [
        { label = "issue #7", link = "https://github.com/brittonr/aspen/issues/7" },
        { label = "Cairn change admit-direct-lan-streams", link = "../.cairn/changes/admit-direct-lan-streams/proposal.md" },
      ],
    },
    {
      id = "q-cross-host",
      text = "Which cross-host transport profile has actual two-host evidence?",
      status = "blocked",
      link = "fabric-transport-session-runtime.md",
    },
    {
      id = "q-qualification",
      text = "Which capabilities have actual validated execution evidence for this exact build/profile? Use the diagnostic report, not handwritten status badges.",
      status = "open",
      link = "capability-qualification-report.md",
    },
  ],
}
