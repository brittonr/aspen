let GeneratedWorkflowNonClaims = [
  "deterministic generation proves only a bounded transformation of admitted policy",
  "an adapter changes representation but does not add authority or lifecycle semantics",
  "generated guidance does not grant command, filesystem, network, model, gate, or release authority",
  "workflow success depends on checked project evidence and does not follow from generated text alone",
] in
let GeneratedWorkflowConstraints = [
  "Use only explicit project roots and policy-known Cairn command classes.",
  "Treat generated text as guidance; policy and gates remain authoritative.",
  "Do not call a model, access the network, or load a remote package.",
] in
let GeneratedPreviewConstraints = [
  "Use only explicit project roots and policy-known Cairn command classes.",
  "Treat generated text as guidance; policy and gates remain authoritative.",
  "Do not call a model, access the network, or load a remote package.",
  "Preview each mutation and execute only the checked, content-bound plan.",
] in
let GeneratedExploreConstraints = [
  "Use only explicit project roots and policy-known Cairn command classes.",
  "Treat generated text as guidance; policy and gates remain authoritative.",
  "Do not call a model, access the network, or load a remote package.",
  "Do not create a change, edit lifecycle artifacts, execute mutation plans, or claim implementation completion.",
] in
let GeneratedWorkflowProgress = "For work with multiple steps, state the next action and report checked evidence after each major step." in
let GeneratedWorkflowOutput = "Return the result, checked evidence, blockers, and the next safe action. Keep paths and command names exact." in
let MinimumWorksetMembers = 1 in
let StoreIdentityNonClaims = [
  "store identity proves only the observed checked projection and native lifecycle identity",
  "store identity does not prove remote freshness, ownership, trust, or VCS synchronization",
  "store identity does not prove requirement truth, implementation, lifecycle readiness, or release eligibility",
] in
let ProjectConfigNonClaims = [
  "a project pointer selects one declared store but does not grant lifecycle authority",
  "a direct reference provides read-only discovery and does not satisfy dependencies, gates, evidence, or requirements",
  "reference indexing does not prove truth, freshness, ownership, implementation, or satisfaction",
  "project configuration does not authorize transitive reference traversal or transport",
  "project facts and advisory guidance do not override generated policy or command authorization",
  "project context checks do not prove truth, secrecy, semantic consistency, agent compliance, or release eligibility",
] in
let LifecycleStoreRequiredNonClaims = [
  "a valid store proves only a bounded native lifecycle identity at one observed local path",
  "registration proves only one machine-local locator mapping",
  "references do not prove truth, freshness, ownership, implementation, or requirement satisfaction",
  "references do not satisfy dependencies, gates, evidence, lifecycle policy, or release policy",
  "worksets do not select lifecycle roots or authorize member mutation",
  "opener plans and process observations do not prove editor state, retained folders, or saved work",
  "store and context commands do not perform VCS, network, credential, or hosting-service transport",
  "local locator and workset receipts are local-only and are not release evidence by default",
  "portable hashes exclude absolute host paths and do not prove cross-machine trust",
  "lifecycle store outputs do not prove lifecycle readiness or release eligibility",
] in
let WorkflowRequiredNonClaims = [
  "workflow state proves only the selected policy graph and observed structural artifact facts",
  "workflow instructions do not prove artifact truth, review quality, or implementation correctness",
  "workflow state does not satisfy proposal, design, tasks, sync, archive, evidence, or release gates",
  "workflow commands are read-only and do not create, edit, delete, or approve lifecycle artifacts",
] in
{
  name = "cairn-default",
  version = 1,

  policy_schema_compatibility = {
    schema_version = PolicySchemaVersion,
    producer = "cairn policy export",
    field_set_digest = PolicyFieldSetDigest,
    refresh_command = "nix run path:$CAIRN_SOURCE#cairn -- policy export --output cairn-policy/generated/cairn-policy.json",
  },

  schemas = [
    {
      schema_version = "cairn.workflow-schema.v1",
