    receipt_fields = ["valid", "request", "bounds", "entries", "portable_entries", "issues", "local_result_hash", "portable_identity", "project_identity", "policy_hash", "non_claims"],
    portable_excluded_fields = ["text", "absolute_path"],
    required_non_claims = [
