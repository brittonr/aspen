      {
        id = "explore",
        version = 1,
        goal = "Inspect project lifecycle state and evidence without creating or changing lifecycle artifacts.",
        success_evidence = ["The report names observed roots, active changes, and policy identities.", "Unknowns and blockers remain explicit."],
        required_evidence = ["Current status and declared project context", "Relevant specifications and workflow instructions"],
        command_classes = ["context", "spec-read", "status", "workflow-inspect"],
        mutation_class = "read_only",
        progress_rule = GeneratedWorkflowProgress,
        immediate_action = "Run cairn status for the explicit project root, then inspect only the relevant specifications and context.",
        output_shape = GeneratedWorkflowOutput,
        constraints = GeneratedExploreConstraints,
        non_claims = GeneratedWorkflowNonClaims,
      },
      {
        id = "propose",
        version = 1,
        goal = "Create a reviewable change package that states the problem, requirements, design, tasks, and evidence plan.",
        success_evidence = ["The package passes proposal, design, and tasks gates.", "Requirements and tasks have complete traceability markers."],
        required_evidence = ["Current specifications and project context", "Declared scope, dependencies, risks, and verification plan"],
        command_classes = ["artifact-edit", "change-create", "context", "spec-read", "workflow-inspect"],
        mutation_class = "preview_first",
        progress_rule = GeneratedWorkflowProgress,
        immediate_action = "Inspect current specifications and status, then preview change creation before writing the bounded package.",
        output_shape = GeneratedWorkflowOutput,
        constraints = GeneratedPreviewConstraints,
        non_claims = GeneratedWorkflowNonClaims,
      },
      {
        id = "verify",
        version = 1,
        goal = "Check requirement coverage, gates, tests, and receipts without changing lifecycle artifacts.",
        success_evidence = ["Required checks pass or return exact diagnostics.", "Traceability has no missing or dangling references."],
        required_evidence = ["Gate and test outputs", "Traceability and receipt identities", "Known blockers and non-claims"],
        command_classes = ["gate", "receipt-inspect", "traceability", "workflow-inspect"],
        mutation_class = "read_only",
        progress_rule = GeneratedWorkflowProgress,
        immediate_action = "Run the smallest required gate and traceability check for the selected change before broad validation.",
        output_shape = GeneratedWorkflowOutput,
        constraints = GeneratedWorkflowConstraints,
        non_claims = GeneratedWorkflowNonClaims,
      },
    ],
    adapters = [
      { id = "agent-skills", version = 1, format = "agent-skills", file_prefix = "cairn-", file_suffix = "", directory_suffix = "/SKILL.md", front_matter = true, max_files = GeneratedWorkflowMaxFilesPerAdapter },
      { id = "claude", version = 1, format = "claude", file_prefix = "cairn-", file_suffix = ".md", directory_suffix = "", front_matter = false, max_files = GeneratedWorkflowMaxFilesPerAdapter },
      { id = "codex", version = 1, format = "codex", file_prefix = "cairn-", file_suffix = ".md", directory_suffix = "", front_matter = false, max_files = GeneratedWorkflowMaxFilesPerAdapter },
    ],
    bounds = {
      max_descriptors = GeneratedWorkflowMaxDescriptors,
      max_adapters = GeneratedWorkflowMaxAdapters,
      max_command_classes = GeneratedWorkflowMaxCommandClasses,
      max_text_bytes = GeneratedWorkflowMaxTextBytes,
      max_list_items = GeneratedWorkflowMaxListItems,
      max_files_per_adapter = GeneratedWorkflowMaxFilesPerAdapter,
      max_path_bytes = GeneratedWorkflowMaxPathBytes,
      max_file_bytes = GeneratedWorkflowMaxFileBytes,
      max_issues = GeneratedWorkflowMaxIssues,
    },
    receipt_fields = ["adapter", "destination", "files", "manifest", "plan_hash", "policy_hash", "non_claims"],
    required_non_claims = GeneratedWorkflowNonClaims,
  },

  lifecycle_stages = ["proposal", "design", "tasks", "implementation", "archive"],

  task_marker_policy = {
    enabled = true,
    stages = ["tasks"],
    strictness = "strict",
    ignore_archives = true,
    markers = [
      { id = "parallel", token = "[parallel]", kind = "literal" },
      { id = "serial", token = "[serial]", kind = "literal" },
      { id = "depends", token = "[depends:<task-or-id>]", kind = "depends-prefix" },
      { id = "task", token = "[task:<id>]", kind = "task-id-prefix" },
      { id = "after", token = "[after:<task-id>]", kind = "task-predecessor-prefix" },
    ],
  },

  finding_defaults = {
    severity = "high",
    class = "omission",
    scope = "tasks",
    route = "auto-fix",
    promoted = "no",
  },

  gate_policy = {
    stages = ["proposal", "design", "tasks"],
    ignore_archives = true,
    finding = {
      severity = "high",
      class = "omission",
      scope = "tasks",
      route = "auto-fix",
      promoted = "no",
    },
    substance = {
      proposal_minimum_substantive_lines = 1,
      design_minimum_substantive_lines = 1,
      minimum_requirement_blocks = 1,
      minimum_substantive_tasks = 1,
      placeholder_tokens = ["cairn_placeholder", "tbd", "describe why", "describe the user-visible", "describe the current state", "implement the change", "verify and archive the change"],
      normative_tokens = ["MUST", "SHALL", "SHOULD", "MAY"],
      dependency_marker_id = "depends",
      dependency_target_class = "lifecycle-id",
    },
  },

  report_contract = {
    verdicts = ["PASS", "WARN", "FAIL"],
    sections = ["Findings", "Required Fixes", "OpenSpec Check", "Gaps", "Next Steps"],
    tagged_findings_required_fields = ["class", "scope", "route", "promoted"],
  },

  machine_contract_policy = {
    schema_version = "cairn.cli-machine.v1",
    exit_classes = [
      { id = "success", process_status = MachineSuccessStatus },
      { id = "invalid_arguments", process_status = MachineInvalidArgumentsStatus },
      { id = "not_found", process_status = MachineNotFoundStatus },
      { id = "policy_error", process_status = MachinePolicyErrorStatus },
      { id = "blocked", process_status = MachineBlockedStatus },
      { id = "internal_error", process_status = MachineInternalErrorStatus },
    ],
    diagnostic_fields = ["code", "severity", "message", "target", "fix"],
    diagnostic_order = [
      "cairn.cli.missing_command",
      "cairn.cli.unknown_command",
      "cairn.cli.incompatible_option",
      "cairn.cli.invocation_preparation_failed",
      "cairn.cli.not_found",
      "cairn.cli.policy_error",
      "cairn.cli.blocked",
      "cairn.cli.output_too_large",
      "cairn.cli.output_invalid",
      "cairn.cli.internal_error",
    ],
    diagnostics = [
      { code = "cairn.cli.missing_command", exit_class = "invalid_arguments", severity = "error", message = "The machine invocation requires a command.", target = "command", fix = "Select one documented command." },
      { code = "cairn.cli.unknown_command", exit_class = "invalid_arguments", severity = "error", message = "The machine invocation selected an unknown command.", target = "command", fix = "Select one documented command." },
      { code = "cairn.cli.incompatible_option", exit_class = "invalid_arguments", severity = "error", message = "The machine invocation selected an incompatible presentation option.", target = "arguments", fix = "Remove human, alternate-format, help, or MCP presentation options." },
      { code = "cairn.cli.invocation_preparation_failed", exit_class = "invalid_arguments", severity = "error", message = "Cairn could not prepare the requested invocation.", target = "arguments", fix = "Check required arguments and admitted path values." },
      { code = "cairn.cli.not_found", exit_class = "not_found", severity = "error", message = "Cairn could not find the requested lifecycle object.", target = "lifecycle-object", fix = "Check the object identity and selected lifecycle root." },
      { code = "cairn.cli.policy_error", exit_class = "policy_error", severity = "error", message = "Cairn rejected the selected runtime policy.", target = "policy", fix = "Refresh and validate the checked policy projection." },
      { code = "cairn.cli.blocked", exit_class = "blocked", severity = "error", message = "Cairn blocked the requested operation before execution.", target = "operation", fix = "Resolve the reported lifecycle blockers before execution." },
      { code = "cairn.cli.output_too_large", exit_class = "internal_error", severity = "error", message = "The command output exceeded the machine contract bound.", target = "output", fix = "Reduce the selected output or use a bounded artifact export." },
      { code = "cairn.cli.output_invalid", exit_class = "internal_error", severity = "error", message = "The command did not produce one admitted JSON result.", target = "output", fix = "Use a machine-compatible command and presentation mode." },
      { code = "cairn.cli.internal_error", exit_class = "internal_error", severity = "error", message = "Cairn could not classify the controlled command failure.", target = "command", fix = "Inspect operator logs without parsing this display message for decisions." },
    ],
    bounds = {
      max_command_bytes = MachineMaxCommandBytes,
      max_diagnostics = MachineMaxDiagnostics,
      max_code_bytes = MachineMaxCodeBytes,
      max_message_bytes = MachineMaxMessageBytes,
      max_target_bytes = MachineMaxTargetBytes,
      max_fix_bytes = MachineMaxFixBytes,
      max_stdout_bytes = MachineMaxStdoutBytes,
      max_stderr_bytes = MachineMaxStderrBytes,
    },
    required_non_claims = [
      "a valid machine envelope proves only that Cairn reached the controlled output boundary and serialized one typed outcome",
      "a machine envelope does not prove nested evidence truth or command correctness",
      "a machine envelope does not prove mutation safety, process reliability, or host integrity",
      "a machine envelope does not prove lifecycle readiness or release eligibility",
      "no envelope is guaranteed after host termination, process kill, memory exhaustion, pre-boundary panic, broken stdout, or failure before Cairn starts",
    ],
  },

  registry_label_policy = {
    channels = ["dev", "nightly", "release", "stable"],
    platforms = ["aarch64-darwin", "aarch64-linux", "x86_64-darwin", "x86_64-linux"],
    compatibility_classes = ["current", "experimental", "legacy"],
    release_format = "YYYY-MM-DD",
  },

  change_metadata_policy = {
    allowed_groups = ["current", "future"],
    group_prefixes = ["feature:"],
    statuses = ["current", "planned", "blocked", "deferred"],
  },

  cross_repo_dependency_policy = {
    schema = "cairn.cross-repo-dependency.v1",
    supported_receipt_kinds = [
      "proposal_gate",
      "design_gate",
      "tasks_gate",
      "validation_receipt",
      "sync_receipt",
      "archive_receipt",
      "radicle-issue.v1",
    ],
    passing_status = "pass",
    non_passing_statuses = [
      "failed",
      "blocked",
      "skipped",
      "deferred",
      "timed_out",
      "dry_run",
      "cancelled",
      "infrastructure_failed",
      "malformed",
      "unsupported",
      "unknown",
      "stale",
    ],
    max_evidence_file_bytes = 65536,
    max_evidence_files = 64,
    required_non_claims = [
      "dependency satisfaction proves presented receipt linkage only",
      "dependency satisfaction does not prove upstream correctness or remote trust",
      "dependency satisfaction does not prove downstream integration correctness or release eligibility",
    ],
  },

  agent_completion_policy = {
    schema = "cairn.agent-completion.v2",
    legacy_classification = "legacy_unscoped",
    passing_status = "passed",
    non_passing_statuses = [
      "failed",
      "blocked",
      "skipped",
      "deferred",
      "timed_out",
      "cancelled",
      "dry_run",
      "cleanup_failed",
      "infrastructure_error",
      "not_selected",
      "unknown",
    ],
    max_input_file_bytes = 65536,
    max_diagnostic_summary_bytes = 512,
    max_reproduction_args = 32,
    forbidden_diagnostic_fields = [
      "raw_prompt",
      "model_output",
      "credentials",
      "environment",
      "stdout",
      "stderr",
      "pty_bytes",
    ],
    required_non_claims = [
      "completion validation does not prove check-oracle soundness",
      "completion validation does not prove honest command execution beyond supplied evidence",
      "completion validation does not prove model correctness",
      "completion validation does not prove whole-product correctness",
      "completion validation does not prove release eligibility outside the selected contract",
    ],
  },

  global_registry_policy = {
    schema = "cairn.global-registry-snapshot.v1",
    storage_schema = "cairn.global-registry-storage.v1",
    max_artifact_bytes = 4194304,
    adapters = [
      { id = "cairn.canonical-records.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["canonical-records"] },
      { id = "cairn.evidence-index.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["evidence-index", "evidence-labels"] },
      { id = "cairn.requirement-registry.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["requirement-registry"] },
      { id = "cairn.change-graph.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["change-graph"] },
      { id = "cairn.cross-repo-dependencies.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["cross-repo-dependencies"] },
      { id = "valence.evidence-ir.v1", kind = "ingest", schema = "cairn.registry-adapter.v1", capabilities = ["read"], record_families = ["valence-evidence-ir"] },
      { id = "memory.v1", kind = "storage", schema = "cairn.global-registry-storage.v1", capabilities = ["load", "commit", "export"], record_families = ["canonical-snapshot"] },
      { id = "portable-json.v1", kind = "storage", schema = "cairn.global-registry-storage.v1", capabilities = ["load", "commit", "export"], record_families = ["canonical-snapshot"] },
      { id = "redb.v1", kind = "storage", schema = "cairn.global-registry-storage.v1", capabilities = ["load", "commit", "export", "migrate"], record_families = ["canonical-snapshot", "node-index", "tag-index", "forward-adjacency", "reverse-adjacency", "source-index"] },
    ],
    tag_namespaces = [
      { id = "operator", authority = "annotation-only" },
      { id = "evidence", authority = "source-preserving" },
      { id = "cairn.policy", authority = "reserved-policy" },
      { id = "cairn.system", authority = "reserved-system" },
    ],
    graph_profiles = [
      { id = "change-dependencies", allowed_node_kinds = ["change"], allowed_edge_kinds = ["change_dependency", "cross_repo_dependency"], require_dag = true },
      { id = "requirement-dependencies", allowed_node_kinds = ["requirement"], allowed_edge_kinds = ["requirement_dependency", "supersedes"], require_dag = true },
      { id = "evidence-derivations", allowed_node_kinds = ["evidence", "artifact"], allowed_edge_kinds = ["derived_from", "contains"], require_dag = true },
      { id = "references", allowed_node_kinds = ["change", "requirement", "evidence", "artifact"], allowed_edge_kinds = ["reference", "alias", "related_to"], require_dag = false },
    ],
    allowed_vocabulary_owners = ["cairn", "valence"],
    required_non_claims = [
      "registry membership proves cataloged identity only",
      "registry tags and graph reachability prove declared metadata and bounded linkage only",
      "registry storage and query success do not prove evidence truth, requirement satisfaction, implementation correctness, verifier soundness, social trust, runtime authority, lifecycle readiness, or release eligibility",
    ],
  },

  lifecycle_store_policy = {
    schema = "cairn.lifecycle-store-policy.v1",
    hash_algorithm = "BLAKE3",
    canonicalization = "serde_json_compact_sorted_keys",
    bounds = {
      max_store_id_bytes = MaxStoreIdBytes,
      max_remote_hint_bytes = MaxRemoteHintBytes,
      max_references = MaxReferences,
      max_locator_entries = MaxLocatorEntries,
      max_workset_id_bytes = MaxWorksetIdBytes,
      max_worksets = MaxWorksets,
      max_workset_members = MaxWorksetMembers,
      max_path_bytes = MaxPathBytes,
      max_context_specs_per_store = MaxContextSpecsPerStore,
      max_spec_title_bytes = MaxSpecTitleBytes,
      max_purpose_summary_bytes = MaxPurposeSummaryBytes,
      max_issue_count = MaxIssueCount,
      max_non_claims = MaxNonClaims,
    },
    store_identity = {
      source_schema = "cairn.lifecycle-store-source.v1",
      projection_schema = "cairn.lifecycle-store-identity.v1",
      source_path = ".cairn-store/store.ncl",
      projection_path = ".cairn-store/store.json",
      source_identity_field = "source_blake3",
      runtime_nickel_evaluation = false,
      stale_projection_rejected = true,
      required_fields = ["schema", "store_id", "remote_hint", "source_blake3", "non_claims"],
      required_non_claims = StoreIdentityNonClaims,
    },
    project_config = {
      source_schema = "cairn.lifecycle-store-project-source.v1",
      projection_schema = "cairn.lifecycle-store-project.v1",
      source_path = ".cairn/project.ncl",
      projection_path = ".cairn/project.json",
      source_identity_field = "source_blake3",
      runtime_nickel_evaluation = false,
      stale_projection_rejected = true,
      required_fields = ["schema", "lifecycle_store", "references", "context_refs", "artifact_guidance", "operation_guidance", "source_blake3", "non_claims"],
      required_non_claims = ProjectConfigNonClaims,
    },
    root_resolution = {
      root_flag = "--root",
      lifecycle_store_flag = "--lifecycle-store",
      selectors_mutually_exclusive = true,
      eligible_commands = [
        "status",
        "spec list",
        "spec show",
        "validate",
        "context",
        "workflow status",
        "workflow instructions",
        "doctor",
      ],
      precedence = [
        "explicit_root",
        "explicit_lifecycle_store",
        "native_root",
        "project_pointer",
        "classic_fallback",
      ],
      native_root_wins_over_project_pointer = true,
      current_directory_only_without_vcs_boundary = true,
      consult_global_registry = false,
      machine_default_store = false,
    },
    locator = {
      schema = "cairn.lifecycle-store-locator.v1",
      relative_path = "cairn/stores/registry.json",
      state_hash_field = "state_hash",
      expected_prior_hash_field = "expected_prior_state_hash",
      hash_algorithm = "BLAKE3",
      preview_required = true,
      lock_kind = "exclusive",
      replacement_kind = "atomic",
      symlink_paths_allowed = false,
    },
    worksets = {
      state = {
        schema = "cairn.lifecycle-store-worksets.v1",
        relative_path = "cairn/worksets/state.json",
        state_hash_field = "state_hash",
        expected_prior_hash_field = "expected_prior_state_hash",
        hash_algorithm = "BLAKE3",
        preview_required = true,
        lock_kind = "exclusive",
        replacement_kind = "atomic",
        symlink_paths_allowed = false,
      },
      required_fields = ["id", "members", "primary_member", "opener_profile"],
      minimum_members = MinimumWorksetMembers,
      opener_profile_field = "opener_profile",
      removal_preserves_members = true,
    },
    opener_profiles = [
      {
        id = "code-new-window",
        executable = "code",
        fixed_args = ["--new-window"],
        member_argument_mode = "positional_paths",
        primary_first = true,
      },
      {
        id = "zed",
        executable = "zed",
        fixed_args = [],
        member_argument_mode = "positional_paths",
        primary_first = true,
      },
    ],
    receipts = {
      schema = "cairn.lifecycle-store-receipt-policy.v1",
      evidence_class = "local-only",
      full_hash_field = "receipt_hash",
      portable_hash_field = "portable_hash",
      required_fields = [
        "schema",
        "command",
        "valid",
        "verdict",
        "evidence_class",
        "resolution",
        "actions",
        "issues",
        "policy_hash",
        "receipt_hash",
        "portable_hash",
        "non_claims",
      ],
      resolution_fields = [
        "source",
        "root",
        "store_id",
        "store_identity",
        "project_identity",
        "diagnostics",
      ],
      local_display_fields = [
        "root",
        "path",
        "checkout_path",
        "resolution.root",
        "actions.path",
        "members.path",
      ],
      portable_fields = [
        "schema",
        "command",
        "store_id",
        "store_identity",
        "project_identity",
        "reference_ids",
        "member_labels",
        "opener_profile",
        "actions",
        "policy_hash",
        "non_claims",
      ],
      portable_excluded_fields = [
        "root",
        "path",
        "checkout_path",
        "resolution.root",
        "actions.path",
        "members.path",
      ],
      local_only_by_default = true,
      release_readiness_consumes_by_default = false,
      required_non_claims = LifecycleStoreRequiredNonClaims,
    },
    issue_codes = [
      "lifecycle_store.claim.overclaim",
      "lifecycle_store.identity.invalid",
      "lifecycle_store.identity.stale_projection",
      "lifecycle_store.locator.duplicate_id",
      "lifecycle_store.locator.duplicate_path",
      "lifecycle_store.locator.identity_changed",
      "lifecycle_store.locator.stale_plan",
      "lifecycle_store.locator.symlink_path",
      "lifecycle_store.project.duplicate_reference",
      "lifecycle_store.project.invalid",
      "lifecycle_store.project.self_reference",
      "lifecycle_store.project.stale_projection",
      "lifecycle_store.reference.transitive_forbidden",
      "lifecycle_store.reference.unregistered",
      "lifecycle_store.remote.unsafe",
      "lifecycle_store.root.conflicting_selectors",
      "lifecycle_store.root.ineligible_command",
      "lifecycle_store.root.unknown_store",
      "lifecycle_store.workset.changed_member",
      "lifecycle_store.workset.execute_required",
      "lifecycle_store.workset.invalid",
      "lifecycle_store.workset.stale_plan",
      "lifecycle_store.workset.unknown_opener",
    ],
    required_non_claims = LifecycleStoreRequiredNonClaims,
  },

  steel_orchestration_policy = {
    enabled = false,
    profiles = [{
      id = "disabled.lifecycle.default",
      mode = "disabled",
      allowed_host_functions = [],
      deterministic_budgets = ["no-evaluation"],
      redaction_classes = ["no-secret-fields"],
