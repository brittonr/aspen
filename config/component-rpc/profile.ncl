{
  profile_id = "molten.component-rpc.hello.v1",
  experimental = true,
  default_enabled = false,
  upstream = {
    repository = "https://github.com/bytecodealliance/wrpc",
    revision = "aa01409ed38bf7a978570ff567c4475376925df6",
    runtime = "wrpc-runtime-wasmtime@0.29.0",
    transport = "wrpc-transport@0.28.4",
    wasmtime = "33.0.0",
  },
  wit = {
    interface = "wrpc-examples:hello/handler",
    function = "hello",
    parameters = [],
    result = "string",
    supported_shape = "bounded-unary-sync",
    streams = false,
    futures = false,
    cancellation = false,
  },
  transport = {
    fabric_port = "molten.fabric.transport.session",
    fabric_version = "v1",
    protocol = "molten.component-rpc.hello.v1",
    alpn = "molten/component-rpc/hello/1",
    sessions = "request-plus-reverse-result",
    echo_acknowledgements_are_rpc_results = false,
    automatic_retries = 0,
    post_effect_failure = "uncertain-reconcile-before-retry",
  },
  bounds = {
    fuel = 10000000,
    memory_bytes = 67108864,
    frame_bytes = 4096,
    instances = 64,
    memories = 16,
    tables = 16,
    table_elements = 65536,
    stack_bytes = 1048576,
    timeout_seconds = 10,
    invocations = 1,
  },
  telemetry = {
    default_enabled = false,
    separate_materialization = true,
    repository = "https://github.com/WebAssembly/wasi-otel",
    revision = "e5262a84044aff064c9599eebc05013bb3432795",
    interface = "wasi:otel/tracing@0.2.0-rc.2",
    ability = "component-rpc/diagnostics-export",
    max_spans = 32,
    max_export_bytes = 65536,
    export_role = "diagnostic-only-not-canonical-evidence",
    otlp_protocol_claim = false,
  },
  non_claims = [
    "not-protocol-stability",
    "not-semantic-equivalence",
    "not-transport-security",
    "not-production-readiness",
    "not-component-correctness",
    "not-existing-protocol-replacement",
  ],
}
