      <module-hex "0061736d010000000104016000000231020f6d6f6c74656e3a686f737463616c6c0661737365727400000f6d6f6c74656e3a686f737463616c6c0473656e6400000303020000073102166d6f6c74656e5f686f737463616c6c5f6173736572740002146d6f6c74656e5f686f737463616c6c5f73656e6400030a0b02040010000b040010010b">
